-- TELEPORTE COM PROXIMITYPROMPT (botão de entrada)
-- ============================================================

local ENTRADA_POSICAO = Vector3.new(1031, 5, 241)
local ENTRADA_DESTINO = Vector3.new(1058, -53, 231)

local function criarBotaoTeleporte(nome, posicao, destino, textoAcao, textoObjeto)
    local anchor = Instance.new("Part")
    anchor.Name = nome
    anchor.Size = Vector3.new(2, 2, 2)
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.Transparency = 1 -- invisível: só serve de ponto de ancoragem para o ProximityPrompt
    anchor.CFrame = CFrame.new(posicao)
    anchor.Parent = workspace

    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = textoAcao or "Teleportar"
    prompt.ObjectText = textoObjeto or "Portal"
    prompt.HoldDuration = 0.5
    prompt.MaxActivationDistance = 8
    prompt.RequiresLineOfSight = false
    prompt.Parent = anchor

    prompt.Triggered:Connect(function(jogador)
        local personagem = jogador.Character
        local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart")
        if raiz then
            raiz.CFrame = CFrame.new(destino + Vector3.new(0, 3, 0))
        end
    end)

    return anchor
end

