local cache = {}

local function carregarAsset(id)
    if cache[id] then return cache[id] end
    local asset
    local ok, res = pcall(function()
        return InsertService:LoadAsset(id)
    end)
    if ok and res then
        asset = res
    else
        local ok2, res2 = pcall(function()
            return game:GetObjects("rbxassetid://" .. id)[1]
        end)
        if ok2 and res2 then asset = res2 end
    end
    cache[id] = asset
    return asset
end

local function normalizarUniqueId(id)
    return (tostring(id):gsub("-", ""):lower())
end

local PROPRIEDADES_DE_CONTEUDO = {
    "MeshId", "TextureID", "TextureId", "Texture", "TextureContent",
    "ImportId", "MeshContent",
}

local function contemAlgumUniqueId(filho, uniqueIds)
    if not uniqueIds then return false end

    local ok, uid = pcall(function() return filho.UniqueId end)
    if ok and uid then
        local norm = normalizarUniqueId(uid)
        if uniqueIds[norm] then
            return true
        end
    end

    for _, propNome in ipairs(PROPRIEDADES_DE_CONTEUDO) do
        local okProp, valor = pcall(function() return filho[propNome] end)
        if okProp and valor then
            local valorStr = tostring(valor):lower()
            for hash in pairs(uniqueIds) do
                if string.find(valorStr, hash, 1, true) then
                    return true
                end
            end
        end
    end

    return false
end

local function removerIndesejados(modelo, info)
    local pastasRemover = info.pastasRemover
    local nomesContem = info.nomesContem
    local uniqueIds = info.uniqueIds

    if not (pastasRemover or nomesContem or uniqueIds) then return end

    local contador = 0
    for _, filho in ipairs(modelo:GetDescendants()) do
        if filho.Parent then
            local deveRemover = false

            if pastasRemover and filho:IsA("Folder") and pastasRemover[filho.Name] then
                deveRemover = true
            elseif nomesContem then
                for _, trecho in ipairs(nomesContem) do
                    if string.find(filho.Name, trecho, 1, true) then
                        deveRemover = true
                        break
                    end
                end
            end

            if not deveRemover and contemAlgumUniqueId(filho, uniqueIds) then
                deveRemover = true
            end

            if deveRemover then
                filho:Destroy()
            end
        end

        contador = contador + 1
        if contador >= YIELD_A_CADA then
            contador = 0
            task.wait()
        end
    end
end

local function anchorarTudo(modelo)
    local contador = 0
    for _, part in ipairs(modelo:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
        end

        contador = contador + 1
        if contador >= YIELD_A_CADA then
            contador = 0
            task.wait()
        end
    end
end

local function aplicarEscala(modelo, escala)
    if not escala or escala == 1 then return end
    if modelo:IsA("Model") then
        local ok, erro = pcall(function()
            modelo:ScaleTo(escala)
        end)
        if not ok then
            warn("Falha ao escalar modelo:", erro)
        end
    end
end

local function grausParaRad(v)
    return math.rad(v.X), math.rad(v.Y), math.rad(v.Z)
end

local function posicionar(modelo, posicao, offset, rotacao, zerarRotacao)
    local rx, ry, rz = grausParaRad(rotacao)
    local rotCF = CFrame.Angles(rx, ry, rz)
    if modelo:IsA("Model") then
        if zerarRotacao then
            local pivoAtual = modelo:GetPivot()
            modelo:PivotTo(CFrame.new(pivoAtual.Position)) -- remove a rotação de fábrica do asset
        end
        local _, tam = modelo:GetBoundingBox()
        modelo:PivotTo(CFrame.new(posicao.X, posicao.Y + (tam.Y / 2) + offset, posicao.Z) * rotCF)
    else
        local part = modelo:IsA("BasePart") and modelo or modelo:FindFirstChildWhichIsA("BasePart")
        if part then
            part.CFrame = CFrame.new(posicao.X, posicao.Y + (part.Size.Y / 2) + offset, posicao.Z) * rotCF
        end
    end
end

local function removerCropLandDoJogo()
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst.Name == "CropLand" and inst.Parent then
            inst:Destroy()
        end
    end
end

local function removerPolesDoMapa()
