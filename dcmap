local CHECKPOINT_FINAL_DESTINO = Vector3.new(1108, 4, 189)

local function criarCheckpoint(indice, posicao, ehFinal)
    local part = Instance.new("Part")
    part.Name = "Checkpoint" .. indice
    part.Size = Vector3.new(4, 6, 4)
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1 -- invisível
    part.CFrame = CFrame.new(posicao)
    part.Parent = workspace

    if ehFinal then
        local debounce = {}
        part.Touched:Connect(function(hit)
            local personagem = hit:FindFirstAncestorOfClass("Model")
            local jogador = personagem and Players:GetPlayerFromCharacter(personagem)
            if not jogador then return end
            if debounce[jogador] then return end

            debounce[jogador] = true
            local raiz = personagem:FindFirstChild("HumanoidRootPart")
            if raiz then
                raiz.CFrame = CFrame.new(CHECKPOINT_FINAL_DESTINO + Vector3.new(0, 3, 0))
            end

            task.delay(2, function()
                debounce[jogador] = nil
            end)
        end)
    end

    return part
end

local function criarTodosOsCheckpoints()
    for i, posicao in ipairs(CHECKPOINTS_POSICOES) do
        local ehFinal = (i == #CHECKPOINTS_POSICOES)
        criarCheckpoint(i, posicao, ehFinal)
    end
end

task.spawn(function()
    removerCropLandDoJogo()
    removerPolesDoMapa()

    for _, info in ipairs(modelos) do
        local rot = info.rotacao or Vector3.new(0, 0, 0)
        local asset = carregarAsset(info.id)

        if asset then
            for _, posicao in ipairs(info.posicoes) do
                local ok, erro = pcall(function()
                    local clone = asset:Clone()
                    clone.Parent = nil -- fica fora do workspace enquanto ainda está desancorado/sujo

                    removerIndesejados(clone, info)
                    anchorarTudo(clone)
                    aplicarEscala(clone, info.escala)
                    posicionar(clone, posicao, info.offset, rot, info.zerarRotacao)

                    clone.Parent = workspace -- só entra no jogo já ancorado e no lugar certo
                end)

                if not ok then
                    warn("Erro ao posicionar", info.id, ":", erro)
                end

                task.wait(0.15)
            end

            -- libera o asset original assim que terminar esse modelo, em vez de segurar tudo em cache até o fim
            if asset.Parent then asset:Destroy() end
            cache[info.id] = nil

            task.wait(0.3) -- respiro maior entre um modelo (potencialmente grande) e o próximo
        else
            warn("Falha ao carregar:", info.id)
        end
    end

    criarBotaoTeleporte("BotaoEntrada", ENTRADA_POSICAO, ENTRADA_DESTINO, "Teleportar", "Portal")
    criarTodosOsCheckpoints()

    print("Todos os modelos carregados, objetos removidos, posicionados e sistema de teleporte criado.")
end)
